{
  "name": "bookmark-house",
  "version": "2.5.0",
  "type": "module",
  "private": true,
  "description": "A local-first Chrome extension for webpage collections and bookmark management",
  "scripts": {
    "check:extension": "node scripts/check_extension.mjs",
    "test:extension": "node --import ./tests/setup-locale.js --test tests/*.mjs",
    "test:package": "python -B -m unittest discover -s tests -p test_*.py",
    "test": "npm run test:extension && npm run test:package",
    "audit:secrets": "python scripts/scan_secrets.py && node scripts/audit_source.mjs",
    "audit:staged": "python scripts/scan_secrets.py --staged && node scripts/audit_source.mjs --staged",
    "prepare:hooks": "git config core.hooksPath .githooks",
    "check": "npm run check:extension && npm run check:i18n && npm test && npm run audit:secrets",
    "package": "node scripts/package.mjs",
    "build:locales": "node scripts/build_popup_locale.mjs",
    "check:i18n": "node scripts/check_i18n.mjs && node scripts/build_popup_locale.mjs --check && node scripts/build_policy_page.mjs --check",
    "build:policy": "node scripts/build_policy_page.mjs"
  },
  "devDependencies": {
    "@secretlint/node": "^13.1.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "acorn": "^8.19.0",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^29.1.1",
    "secretlint": "^13.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/leeguandong/bookmark-house.git"
  },
  "homepage": "https://github.com/leeguandong/bookmark-house#readme",
  "bugs": {
    "url": "https://github.com/leeguandong/bookmark-house/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "chrome-extension",
    "bookmarks",
    "web-clipper",
    "local-first"
  ]
}
